# ============================================================
# Environment Variables Configuration
# ============================================================

# 1. Node Environment
NODE_ENV=production
PORT=3000

# 2. Database Connection (Choose Option A or Option B)
# Option A: Single Connection String (Recommended for Supabase, Neon, Railway, Render, etc.)
DATABASE_URL="postgresql://username:password@host:5432/database_name?sslmode=require"

# Option B: Individual PostgreSQL Parameters
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="your_password"
SQL_DB_NAME="postgres"

# 3. Gemini AI API Key (Optional - for AI Article Generator in Admin Panel)
GEMINI_API_KEY="AIzaSy..."

# 4. App URL (Optional)
APP_URL="https://yourdomain.com"
